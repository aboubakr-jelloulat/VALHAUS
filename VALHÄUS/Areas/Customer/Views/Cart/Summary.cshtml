@model ShoppingCartVM

@section Styles {
    <link rel="stylesheet" href="~/css/Cart/summary.css" asp-append-version="true" />
}

<!-- Video Background -->
<div class="video-background">
    <video autoplay muted loop playsinline>
        <source src="https://assets.mixkit.co/videos/preview/mixkit-elegant-luxury-fashion-store-interior-27496-large.mp4" type="video/mp4">
    </video>
</div>
<div class="video-overlay"></div>

<div class="order-summary-container">
    <div class="container">
        <form method="post">
            <div class="summary-card">
                <!-- Header -->
                <div class="summary-header">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h3>Order Summary</h3>
                        </div>
                        <div class="col-md-6 text-md-end mt-3 mt-md-0">
                            <a asp-action="Index" class="back-btn">
                                ← Back to Cart
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Body -->
                <div class="summary-body">
                    <div class="row">
                        <!-- Shipping Details -->
                        <div class="col-lg-7 mb-4 mb-lg-0">
                            <div class="shipping-section">
                                <h4 class="section-title">
                                    Shipping Details
                                </h4>

                                <div class="form-group">
                                    <label class="form-label">Full Name</label>
                                    <input asp-for="OrderHeader.Name"
                                           class="form-control"
                                           value="@Model.OrderHeader.Name"
                                           placeholder="Enter your full name" />
                                    <span asp-validation-for="OrderHeader.Name" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Phone Number</label>
                                    <input asp-for="OrderHeader.PhoneNumber"
                                           class="form-control"
                                           value="@Model.OrderHeader.PhoneNumber"
                                           placeholder="Enter your phone number"
                                           required />
                                    <span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Street Address</label>
                                    <input asp-for="OrderHeader.StreetAddress"
                                           class="form-control"
                                           value="@Model.OrderHeader.StreetAddress"
                                           placeholder="Enter your street address" />
                                    <span asp-validation-for="OrderHeader.StreetAddress" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">City</label>
                                            <input asp-for="OrderHeader.City"
                                                   class="form-control"
                                                   value="@Model.OrderHeader.City"
                                                   placeholder="City" />
                                            <span asp-validation-for="OrderHeader.City" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">State</label>
                                            <input asp-for="OrderHeader.State"
                                                   class="form-control"
                                                   value="@Model.OrderHeader.State"
                                                   placeholder="State" />
                                            <span asp-validation-for="OrderHeader.State" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Postal Code</label>
                                    <input asp-for="OrderHeader.PostalCode"
                                           class="form-control"
                                           value="@Model.OrderHeader.PostalCode"
                                           placeholder="Postal code" />
                                    <span asp-validation-for="OrderHeader.PostalCode" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Order Summary -->
                        <div class="col-lg-5">
                            <div class="summary-section">
                                <h4 class="section-title">
                                    Your Order
                                </h4>

                                @if (Model.ShoppingCartList != null && Model.ShoppingCartList.Any())
                                {
                                    @foreach (var details in Model.ShoppingCartList)
                                    {
                                        <div class="order-item">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="flex-grow-1">
                                                    <h6 class="order-item-title">@details.Product.Title</h6>
                                                    <p class="order-item-quantity">
                                                        Quantity: <strong>@details.Count</strong>
                                                    </p>
                                                </div>
                                                <div class="text-end">
                                                    <div class="order-item-price">
                                                        @((details.Price * details.Count).ToString("c"))
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="order-item">
                                        <p style="color: rgba(255, 255, 255, 0.6); text-align: center; margin: 0;">
                                            Your cart is empty
                                        </p>
                                    </div>
                                }

                                <div class="order-total-card">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <p class="order-total-label">Total Amount</p>
                                            <p class="order-total-amount">@Model.OrderHeader.OrderTotal.ToString("c")</p>
                                        </div>
                                        <div style="font-size: 3rem; opacity: 0.3;">💳</div>
                                    </div>
                                </div>

                                <!-- Place Order -->
                                <button type="submit" class="place-order-btn">
                                    Complete Order
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

