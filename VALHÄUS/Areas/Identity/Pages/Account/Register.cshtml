@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VALHAUS</title>
    
    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            height: 100%;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            overflow-x: hidden;
        }

        /* Video Background */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            overflow: hidden;
        }

        .video-background video {
            position: absolute;
            top: 50%;
            left: 50%;
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            transform: translate(-50%, -50%);
            object-fit: cover;
        }

        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: linear-gradient(135deg, rgba(26, 26, 26, 0.85) 0%, rgba(45, 45, 45, 0.75) 100%);
        }

        /* Light Mode Overlay */
        [data-bs-theme="light"] .video-overlay {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(248, 249, 250, 0.88) 100%);
        }

        /* Container */
        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            position: relative;
        }

        /* Glassmorphic Card */
        .auth-card {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 24px;
            padding: 48px;
            width: 100%;
            max-width: 680px;
            box-shadow: 0 20px 80px rgba(0, 0, 0, 0.4);
            position: relative;
            overflow: hidden;
            animation: slideIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Light Mode Card */
        [data-bs-theme="light"] .auth-card {
            background: rgba(255, 255, 255, 0.75);
            border: 1px solid rgba(212, 175, 55, 0.2);
            box-shadow: 0 20px 80px rgba(0, 0, 0, 0.1);
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Card Shine Effect */
        .auth-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                45deg,
                transparent,
                rgba(212, 175, 55, 0.1),
                transparent
            );
            transform: rotate(45deg);
            animation: shine 3s infinite;
        }

        @@keyframes shine {
            0%, 100% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
            50% { transform: translateX(100%) translateY(100%) rotate(45deg); }
        }

        /* Header */
        .auth-header {
            text-align: center;
            margin-bottom: 40px;
            position: relative;
            z-index: 1;
        }

        .auth-logo {
            font-size: 32px;
            font-weight: 700;
            background: linear-gradient(135deg, #d4af37 0%, #f4d477 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 12px;
            letter-spacing: 2px;
        }

        .auth-title {
            font-size: 28px;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 8px;
        }

        [data-bs-theme="light"] .auth-title {
            color: #1a1a1a;
        }

        .auth-subtitle {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.7);
            font-weight: 400;
        }

        [data-bs-theme="light"] .auth-subtitle {
            color: rgba(26, 26, 26, 0.6);
        }

        /* Form Sections */
        .form-section {
            margin-bottom: 32px;
            position: relative;
            z-index: 1;
        }

        .section-title {
            font-size: 14px;
            font-weight: 600;
            color: #d4af37;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .section-title i {
            font-size: 16px;
        }

        /* Form Groups */
        .form-group {
            margin-bottom: 20px;
            position: relative;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.85);
            margin-bottom: 8px;
            transition: color 0.3s ease;
        }

        [data-bs-theme="light"] .form-group label {
            color: rgba(26, 26, 26, 0.75);
        }

        /* Input Fields */
        .form-control, .form-select {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 14px 18px;
            font-size: 15px;
            color: #ffffff;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(10px);
        }

        [data-bs-theme="light"] .form-control,
        [data-bs-theme="light"] .form-select {
            background: rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(212, 175, 55, 0.2);
            color: #1a1a1a;
        }

        .form-control:focus, .form-select:focus {
            background: rgba(255, 255, 255, 0.12);
            border-color: #d4af37;
            box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.15);
            color: #ffffff;
            outline: none;
        }

        [data-bs-theme="light"] .form-control:focus,
        [data-bs-theme="light"] .form-select:focus {
            background: rgba(255, 255, 255, 0.95);
            color: #1a1a1a;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.4);
        }

        [data-bs-theme="light"] .form-control::placeholder {
            color: rgba(26, 26, 26, 0.3);
        }

        /* Select Dropdown - Fix dark mode option visibility */
        .form-select option {
            background-color: #2a2a2a;
            color: #ffffff;
        }

        [data-bs-theme="light"] .form-select option {
            background-color: #ffffff;
            color: #1a1a1a;
        }

        /* Two Column Grid */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        /* Submit Button */
        .btn-submit {
            width: 100%;
            padding: 16px;
            font-size: 16px;
            font-weight: 600;
            color: #1a1a1a;
            background: linear-gradient(135deg, #d4af37 0%, #f4d477 100%);
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 8px 24px rgba(212, 175, 55, 0.3);
            position: relative;
            overflow: hidden;
        }

        .btn-submit::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.5s;
        }

        .btn-submit:hover::before {
            left: 100%;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(212, 175, 55, 0.4);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        /* Validation */
        .text-danger {
            font-size: 12px;
            margin-top: 6px;
            display: block;
            color: #ff6b6b;
        }

        /* Footer Links */
        .auth-footer {
            text-align: center;
            margin-top: 32px;
            position: relative;
            z-index: 1;
        }

        .auth-footer a {
            color: #d4af37;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .auth-footer a:hover {
            color: #f4d477;
            text-decoration: underline;
        }

        /* Theme Toggle */
        .theme-toggle {
            position: fixed;
            top: 24px;
            right: 24px;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1000;
        }

        [data-bs-theme="light"] .theme-toggle {
            background: rgba(255, 255, 255, 0.7);
            border: 1px solid rgba(212, 175, 55, 0.2);
        }

        .theme-toggle:hover {
            transform: scale(1.1);
            background: rgba(212, 175, 55, 0.2);
        }

        .theme-toggle i {
            font-size: 20px;
            color: #d4af37;
            transition: transform 0.3s ease;
        }

        .theme-toggle:active i {
            transform: rotate(180deg);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .auth-card {
                padding: 32px 24px;
            }

            .grid-2 {
                grid-template-columns: 1fr;
            }

            .auth-title {
                font-size: 24px;
            }

            .auth-logo {
                font-size: 28px;
            }
        }

        @@media (max-width: 480px) {
            .auth-container {
                padding: 20px 16px;
            }

            .auth-card {
                padding: 28px 20px;
                border-radius: 20px;
            }

            .form-section {
                margin-bottom: 24px;
            }
        }
    </style>
</head>
<body>
    <!-- Video Background -->
    <div class="video-background">
        <video autoplay muted loop playsinline>
            <source src="https://cdn.shopify.com/videos/c/o/v/870989f137f944e6b731fff1475471ce.mp4" type="video/mp4">
        </video>
    </div>
    <div class="video-overlay"></div>

    <!-- Theme Toggle -->
    <button id="theme-toggle" class="theme-toggle" title="Toggle Theme">
        <i class="bi bi-sun-fill"></i>
    </button>

    <div class="auth-container">
        <div class="auth-card">
            <!-- Header -->
            <div class="auth-header">
                <div class="auth-logo">VALHÄUS</div>
                <h1 class="auth-title">Create Your Account</h1>
                <p class="auth-subtitle">Join us and start your luxury experience</p>
            </div>

            <!-- Form -->
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <!-- Account Information -->
                <div class="form-section">
                    <div class="section-title">
                        <i class="bi bi-person-circle"></i>
                        <span>Account Information</span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Email">Email Address</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Name">Full Name</label>
                        <input asp-for="Input.Name" class="form-control" autocomplete="name" aria-required="true" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label asp-for="Input.Password">Password</label>
                            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Address Information -->
                <div class="form-section">
                    <div class="section-title">
                        <i class="bi bi-geo-alt"></i>
                        <span>Address Information (Optional)</span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.StreetAddress">Street Address</label>
                        <input asp-for="Input.StreetAddress" class="form-control" autocomplete="street-address" />
                        <span asp-validation-for="Input.StreetAddress" class="text-danger"></span>
                    </div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label asp-for="Input.City">City</label>
                            <input asp-for="Input.City" class="form-control" autocomplete="address-level2" />
                            <span asp-validation-for="Input.City" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.State">State</label>
                            <input asp-for="Input.State" class="form-control" autocomplete="address-level1" />
                            <span asp-validation-for="Input.State" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.PostalCode">Postal Code</label>
                        <input asp-for="Input.PostalCode" class="form-control" autocomplete="postal-code" />
                        <span asp-validation-for="Input.PostalCode" class="text-danger"></span>
                    </div>
                </div>

                <!-- Role Selection -->
                <div class="form-section">
                    <div class="section-title">
                        <i class="bi bi-shield-check"></i>
                        <span>Account Type</span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Role">Select Role</label>
                        <select asp-for="Input.Role" asp-items="@Model.Input.RoleList" class="form-select">
                            <option value="">Choose your role...</option>
                        </select>
                        <span asp-validation-for="Input.Role" class="text-danger"></span>
                    </div>
                </div>


                <!-- Company Selection -->
                <div class="form-section" id="companySection" style="display:none;">
                    <div class="section-title">
                        <i class="bi bi-building"></i>
                        <span>Company</span>    
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.CompanyId">Select Company</label>
                        <select asp-for="Input.CompanyId" asp-items="@Model.Input.CompanyList" class="form-select">
                            <option value="">Choose your company...</option>
                        </select>
                        <span asp-validation-for="Input.CompanyId" class="text-danger"></span>
                    </div>
                </div>


                <!-- Submit Button -->
                <button id="registerSubmit" type="submit" class="btn-submit">
                    Create Account
                </button>

                <!-- Footer -->
                <div class="auth-footer">
                    <p style="color: rgba(255, 255, 255, 0.7); font-size: 14px; margin-bottom: 0;">
                        Already have an account? <a asp-page="./Login">Sign in here</a>
                    </p>
                </div>
            </form>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Dark Mode Toggle -->
    <script>
        (function () {
            'use strict';

            const getStoredTheme = () => localStorage.getItem('valhaus-theme');
            const setStoredTheme = (theme) => localStorage.setItem('valhaus-theme', theme);

            const getPreferredTheme = () => {
                const storedTheme = getStoredTheme();
                if (storedTheme) {
                    return storedTheme;
                }
                const isDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;
                return isDarkMode ? 'dark' : 'light';
            };

            const setTheme = (theme) => {
                document.documentElement.setAttribute('data-bs-theme', theme);
                updateIcon(theme);
            };

            const updateIcon = (theme) => {
                const toggle = document.getElementById('theme-toggle');
                if (!toggle) return;

                const icon = toggle.querySelector('i');
                if (!icon) return;

                if (theme === 'dark') {
                    icon.className = 'bi bi-moon-stars';
                } else {
                    icon.className = 'bi bi-sun-fill';
                }
            };

            const toggleTheme = () => {
                const currentTheme = getStoredTheme() || getPreferredTheme();
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                setStoredTheme(newTheme);
                setTheme(newTheme);
            };

            const initTheme = () => {
                const preferredTheme = getPreferredTheme();
                setTheme(preferredTheme);
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initTheme);
            } else {
                initTheme();
            }

            window.addEventListener('DOMContentLoaded', () => {
                const themeToggle = document.getElementById('theme-toggle');
                if (themeToggle) {
                    themeToggle.addEventListener('click', toggleTheme);
                }
            });
        })();
    </script>

    <!-- Company Toggle Script -->
    <script>
        console.log('Script loaded, jQuery version:', $.fn.jquery);
        
        $(document).ready(function () {
            console.log('Document ready');
            console.log('Company section exists:', $('#companySection').length > 0);
            console.log('Role dropdown exists:', $('#Input_Role').length > 0);
            
            // Function to check role and toggle company section
            function checkRoleAndToggleCompany() {
                var selectedValue = $('#Input_Role').val();
                var selectedText = $('#Input_Role option:selected').text();
                
                console.log('Checking role - Value:', selectedValue, 'Text:', selectedText);
                
                // Check both value and text to be sure
                if(selectedValue === 'Company' || selectedText === 'Company'){
                    console.log('Showing company section');
                    $('#companySection').show();
                }
                else{
                    console.log('Hiding company section');
                    $('#companySection').hide();
                }
            }
            
            // Check initial state on page load (for form validation errors)
            checkRoleAndToggleCompany();
            
            // Toggle company section when role selection changes
            $('#Input_Role').on('change', function(){
                console.log('Role changed!');
                checkRoleAndToggleCompany();
            });
        });
    </script>

</body>
</html>
