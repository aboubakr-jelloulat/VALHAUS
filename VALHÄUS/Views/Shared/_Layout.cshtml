@using Valhaus.Data.Repository.IRepository
@using System.Security.Claims

@* old way without use the session *@
@inject IUnitOfWork UnitOfWork 

@* acces the shopping cart session *@
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VALHAUS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    @* Nimbus Theme *@
    <link rel="stylesheet" href="~/css/nimbus/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/nimbus/onepage.css" />
    <link rel="stylesheet" href="~/css/nimbus/vendors/aos.css" />

    @* Icons *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    @* Dark Mode Styles *@
    <link rel="stylesheet" href="~/css/DarkMode/dark-mode.css" />

    @* Custom Site Styles *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VALHAUS.styles.css" asp-append-version="true" />

    @* toastr Notification*@
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />

    @* DataTables API  *@
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

    @* Page Specific Styles *@
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm border-bottom box-shadow mb-3">
            <div class="container-fluid">
                

                @* Mobile Menu Toggle *@
                <button class="navbar-toggler"  type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto">
                        @* Home *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Customer" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>

                    @if(User.IsInRole(StaticDetails.Role_Admin))
                    {
                            @* Category *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Admin" asp-controller="Category" asp-action="Index">
                                    <i class="bi bi-grid"></i> Categories
                                </a>
                            </li>
                            @* Product *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Admin" asp-controller="Product" asp-action="Index">
                                    <i class="bi bi-box-seam"></i> Products
                                </a>
                            </li>
                            @* Company *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Admin" asp-controller="Company" asp-action="Index">
                                    <i class="bi bi-building"></i> Company
                                </a>
                            </li>
                           @* Order Management *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Admin" asp-controller="Order" asp-action="Index">
                                    <i class="bi bi-box-seam-fill"></i> Order Management
                                </a>
                            </li>

                            @* Manage Users *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Admin" asp-controller="User" asp-action="Index">
                                    <i class="bi bi-people-fill"></i> Manage Users
                                </a>
                            </li>

                            @* Create User *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">
                                    <i class="bi bi-person-plus"></i> Create User
                                </a>
                            </li>

                    }

                        
                    </ul>
                    @* Cart *@
                    <div class="d-flex align-items-center me-3">
                        <a asp-area="Customer" asp-controller="Cart" asp-action="Index" class="nav-link position-relative text-dark">
                                @* using view Components *@
                                
                            @await Component.InvokeAsync("ShoppingCart")



                            @* depend in data base not session - my old way *@
                            @* @if (User.Identity.IsAuthenticated)
                            {
                                var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                                if (userId != null)
                                {
                                    var count = UnitOfWork.ShoppingCart.GetAll(u => u.ApplicationUserId == userId).Count();
                                    if (count > 0)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.7em;">
                                            @count
                                            <span class="visually-hidden">items in cart</span>
                                        </span>
                                    }
                                }
                            } *@

                            @* without the view component this is a bad practice *@

                            @* @if (HttpContextAccessor.HttpContext.Session.GetInt32(StaticDetails.SessionCart) is not null)
                            {
                                var count = HttpContextAccessor.HttpContext.Session.GetInt32(StaticDetails.SessionCart);
                                
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.7em;">
                                        @count
                                    <span class="visually-hidden">items in cart</span>
                                </span>
                            } *@

                        </a>
                    </div>
                    <partial name="_LoginPartial">

                        @* Dark Mode Toggle *@
                    <div class="d-flex align-items-center">
                        <button id="theme-toggle" class="btn-theme-toggle" title="Toggle Dark Mode" aria-label="Toggle dark mode">
                            <i class="bi bi-sun-fill theme-icon"></i>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @* Main Content Area *@
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Notification"> </partial>
            @RenderBody()
        </main>
    </div>

    @* foother *@
    <footer class="border-top mt-3 py-2 text-center">
        <a href="https://github.com/aboubakr-jelloulat/VALHAUS"
           target="_blank" class="text-muted text-decoration-none">
            <i class="bi bi-github"></i> Drop a star on GitHub ⭐
        </a>
    </footer>





    @* jQuery Js*@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @* Bootstrap Js*@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @* Nimbus Theme JS *@
    <script src="~/js/nimbus/bootstrap.bundle.min.js"></script>
    <script src="~/js/nimbus/vendors/aos.js"></script>
    <script src="~/js/nimbus/custom.js"></script>

    @* Dark Mode Toggle *@
    <script src="~/js/DarkMode/dark-mode-toggle.js"></script>

    @* Site JS *@
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* DataTables *@
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    @* SweetAlert *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>