@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}




<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VALHAUS</title>
    
    @* Bootstrap *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    @* Bootstrap Icons *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    @* Google Fonts *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/Register/register.css" asp-append-version="true" />
    
</head>
<body>
    @* Video Background *@
    <div class="video-background">
        <video autoplay muted loop playsinline>
            <source src="https://cdn.shopify.com/videos/c/o/v/870989f137f944e6b731fff1475471ce.mp4" type="video/mp4">
        </video>
    </div>
    <div class="video-overlay"></div>

    @* Theme Toggle *@
    <button id="theme-toggle" class="theme-toggle" title="Toggle Theme">
        <i class="bi bi-sun-fill"></i>
    </button>

    <div class="auth-container">
        <div class="auth-card">
            <!-- Header -->
            <div class="auth-header">
                <div class="auth-logo">VALHÄUS</div>
                
                <h1 class="auth-title">
                    @(User.IsInRole(StaticDetails.Role_Admin) ? "Add User Account" : "Create Your Account")
                </h1>

                <p class="auth-subtitle">Join us and start your luxury experience</p>
            </div>

            <!-- Google Login Section -->
            @if (!User.IsInRole(StaticDetails.Role_Admin))
            {
                @* Only show external login buttons for admins *@
                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" style="position: relative; z-index: 1; margin-bottom: 0;">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit"
                                    class="btn-google"
                                    name="provider"
                                    value="@provider.Name"
                                    title="Sign up using your @provider.DisplayName account">
                                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M17.64 9.20454C17.64 8.56636 17.5827 7.95273 17.4764 7.36364H9V10.845H13.8436C13.635 11.97 13.0009 12.9232 12.0477 13.5614V15.8195H14.9564C16.6582 14.2527 17.64 11.9455 17.64 9.20454Z" fill="#4285F4" />
                                    <path d="M9 18C11.43 18 13.4673 17.1941 14.9564 15.8195L12.0477 13.5614C11.2418 14.1014 10.2109 14.4205 9 14.4205C6.65591 14.4205 4.67182 12.8373 3.96409 10.71H0.957273V13.0418C2.43818 15.9832 5.48182 18 9 18Z" fill="#34A853" />
                                    <path d="M3.96409 10.71C3.78409 10.17 3.68182 9.59318 3.68182 9C3.68182 8.40682 3.78409 7.83 3.96409 7.29V4.95818H0.957273C0.347727 6.17318 0 7.54773 0 9C0 10.4523 0.347727 11.8268 0.957273 13.0418L3.96409 10.71Z" fill="#FBBC05" />
                                    <path d="M9 3.57955C10.3214 3.57955 11.5077 4.03364 12.4405 4.92545L15.0218 2.34409C13.4632 0.891818 11.4259 0 9 0C5.48182 0 2.43818 2.01682 0.957273 4.95818L3.96409 7.29C4.67182 5.16273 6.65591 3.57955 9 3.57955Z" fill="#EA4335" />
                                </svg>
                                <span>Continue with @provider.DisplayName</span>
                            </button>
                        }
                    </form>

                    @* Divider *@
                    <div class="auth-divider">
                        <span>OR SIGN UP WITH EMAIL</span>
                    </div>
                }
            }


            @* Form *@
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                @* Account *@
                <div class="form-section">
                    <div class="section-title">
                        <i class="bi bi-person-circle"></i>
                        <span>Account Information</span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Email">Email Address</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Name">Full Name</label>
                        <input asp-for="Input.Name" class="form-control" autocomplete="name" aria-required="true" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.PhoneNumber" class="form-label">Phone Number</label>
                        <input asp-for="Input.PhoneNumber" class="form-control" type="tel" placeholder="+47" autocomplete="tel" aria-required="true" pattern="^\+?[0-9\s]{7,20}$" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>


                    <div class="grid-2">
                        <div class="form-group">
                            <label asp-for="Input.Password">Password</label>
                            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                @* Address *@
                <div class="form-section">
                    <div class="section-title">
                        <i class="bi bi-geo-alt"></i>
                        <span>Address Information (Optional)</span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.StreetAddress">Street Address</label>
                        <input asp-for="Input.StreetAddress" class="form-control" autocomplete="street-address" />
                        <span asp-validation-for="Input.StreetAddress" class="text-danger"></span>
                    </div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label asp-for="Input.City">City</label>
                            <input asp-for="Input.City" class="form-control" autocomplete="address-level2" />
                            <span asp-validation-for="Input.City" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.State">State</label>
                            <input asp-for="Input.State" class="form-control" autocomplete="address-level1" />
                            <span asp-validation-for="Input.State" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.PostalCode">Postal Code</label>
                        <input asp-for="Input.PostalCode" class="form-control" autocomplete="postal-code" />
                        <span asp-validation-for="Input.PostalCode" class="text-danger"></span>
                    </div>
                </div>
                 
                @if (User.IsInRole(StaticDetails.Role_Admin))
                {
                @* Role Selection  *@
                <div class="form-section">
                    <div class="section-title">
                        <i class="bi bi-shield-check"></i>
                        <span>Account Type</span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Role">Select Role</label>
                        <select asp-for="Input.Role" asp-items="@Model.Input.RoleList" class="form-select">
                            <option value="">Choose your role...</option>
                        </select>
                        <span asp-validation-for="Input.Role" class="text-danger"></span>
                    </div>
                </div>


                @* Company Selection *@
                <div class="form-section" id="companySection" style="display:none;">
                    <div class="section-title">
                        <i class="bi bi-building"></i>
                        <span>Company</span>    
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.CompanyId">Select Company</label>
                        <select asp-for="Input.CompanyId" asp-items="@Model.Input.CompanyList" class="form-select">
                            <option value="">Choose your company...</option>
                        </select>
                        <span asp-validation-for="Input.CompanyId" class="text-danger"></span>
                    </div>
                </div>
                }

                @* Submit btn *@
                <button id="registerSubmit" type="submit" class="btn-submit">
                    Create Account
                </button>

                @* Already have an account *@
                <div class="auth-footer">
                    <p style="color: rgba(255, 255, 255, 0.7); font-size: 14px; margin-bottom: 0;">
                        Already have an account? <a asp-page="./Login">Sign in here</a>
                    </p>
                </div>
            </form>
        </div>
    </div>

 
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    Dark Mode Toggle
    <script>
        (function () {
            'use strict';

            const getStoredTheme = () => localStorage.getItem('valhaus-theme');
            const setStoredTheme = (theme) => localStorage.setItem('valhaus-theme', theme);

            const getPreferredTheme = () => {
                const storedTheme = getStoredTheme();
                if (storedTheme) {
                    return storedTheme;
                }
                const isDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;
                return isDarkMode ? 'dark' : 'light';
            };

            const setTheme = (theme) => {
                document.documentElement.setAttribute('data-bs-theme', theme);
                updateIcon(theme);
            };

            const updateIcon = (theme) => {
                const toggle = document.getElementById('theme-toggle');
                if (!toggle) return;

                const icon = toggle.querySelector('i');
                if (!icon) return;

                if (theme === 'dark') {
                    icon.className = 'bi bi-moon-stars';
                } else {
                    icon.className = 'bi bi-sun-fill';
                }
            };

            const toggleTheme = () => {
                const currentTheme = getStoredTheme() || getPreferredTheme();
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                setStoredTheme(newTheme);
                setTheme(newTheme);
            };

            const initTheme = () => {
                const preferredTheme = getPreferredTheme();
                setTheme(preferredTheme);
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initTheme);
            } else {
                initTheme();
            }

            window.addEventListener('DOMContentLoaded', () => {
                const themeToggle = document.getElementById('theme-toggle');
                if (themeToggle) {
                    themeToggle.addEventListener('click', toggleTheme);
                }
            });
        })();
    </script>

    @* Company Toggle Script : load the company and made it iteractive  *@
    <script>
        console.log('Script loaded, jQuery version:', $.fn.jquery);
        
        $(document).ready(function () {
            console.log('Document ready');
            console.log('Company section exists:', $('#companySection').length > 0);
            console.log('Role dropdown exists:', $('#Input_Role').length > 0);
            
            // Function to check role and toggle company section
            function checkRoleAndToggleCompany() {
                var selectedValue = $('#Input_Role').val();
                var selectedText = $('#Input_Role option:selected').text();
                
                console.log('Checking role - Value:', selectedValue, 'Text:', selectedText);
                
                // Check both value and text to be sure
                if(selectedValue === 'Company' || selectedText === 'Company'){
                    console.log('Showing company section');
                    $('#companySection').show();
                }
                else{
                    console.log('Hiding company section');
                    $('#companySection').hide();
                }
            }
            
            // Check initial state on page load (for form validation errors)
            checkRoleAndToggleCompany();
            
            // Toggle company section when role selection changes
            $('#Input_Role').on('change', function(){
                console.log('Role changed!');
                checkRoleAndToggleCompany();
            });
        });
    </script>

</body>
</html>
