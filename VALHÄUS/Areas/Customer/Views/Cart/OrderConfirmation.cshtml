@model int

<style>
    :root {
        --primary: #ff7849;
        --primary-hover: #ff6633;
        --text: #1f2937;
        --text-light: #9ca3af;
        --bg: #f9fafb;
        --card: #ffffff;
    }

    [data-bs-theme="dark"] {
        --text: #f9fafb;
        --bg: #0f172a;
        --card: #1e293b;
    }

    .order-success {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg);
        padding: 2rem;
        transition: background 0.3s;
    }

    .card {
        background: var(--card);
        border-radius: 16px;
        padding: 4rem 3rem;
        max-width: 500px;
        text-align: center;
        box-shadow: 0 10px 40px rgba(0,0,0,0.08);
        transition: background 0.3s;
    }

    .checkmark {
        width: 80px;
        height: 80px;
        background: var(--primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
    }

        .checkmark svg {
            width: 40px;
            height: 40px;
            stroke: white;
            stroke-width: 4;
            fill: none;
        }

    h1 {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 1rem;
        transition: color 0.3s;
    }

    p {
        color: var(--text-light);
        line-height: 1.6;
        margin-bottom: 0.75rem;
        transition: color 0.3s;
    }

    .order-num {
        font-size: 0.875rem;
        margin-bottom: 2rem;
    }

    .btn {
        display: inline-block;
        padding: 0.875rem 2.5rem;
        background: var(--primary);
        color: white;
        font-weight: 600;
        text-decoration: none;
        border-radius: 8px;
        transition: all 0.3s;
    }

        .btn:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            color: white;
            text-decoration: none;
        }

    @@media (max-width: 640px) {
        .card {
            padding: 3rem 2rem;
        }

        h1 {
            font-size: 1.5rem;
        }
    }
</style>

<div class="order-success">
    <div class="card">
        <div class="checkmark">
            <svg viewBox="0 0 52 52">
                <polyline points="14 27 22 35 38 19" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>

        <h1>Thank you for ordering!</h1>
        <p>Your order has been confirmed successfully and will be processed shortly.</p>
        @* <p class="order-num">Order #@Model</p> *@

        <a href="@Url.Action("Index", "Home")" class="btn">CONTINUE SHOPPING</a>
    </div>
</div>

<script>
    new MutationObserver(() => {
        document.querySelector('.order-success').offsetHeight;
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-bs-theme'] });
</script>