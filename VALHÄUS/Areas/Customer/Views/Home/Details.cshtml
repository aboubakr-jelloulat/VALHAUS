@model ShoppingCart

@{
    ViewData["Title"] = Model.Product.Title;
}

<link rel="stylesheet" href="~/css/details.css" />

@section Styles {
    <link rel="stylesheet" href="~/css/Home/details.css" asp-append-version="true" />
}


<div class="details-wrapper">
    <div class="product-details-container">
        <!-- Back Button -->
        <a asp-action="Index" class="back-btn">
            <i class="bi bi-arrow-left"></i>
            <span>Back to Home</span>
        </a>

        <!-- Product Grid -->
        <div class="product-grid">
            <!-- LEFT COLUMN: Product Image -->
            <div class="left-column">
                <div class="product-image-container">
                    @{
                        var discount = Math.Round(((Model.Product.ListPrice - Model.Product.Price) / Model.Product.ListPrice) * 100);
                    }
                    @if (discount > 0)
                    {
                        <div class="discount-badge">
                            <i class="bi bi-tag-fill"></i>
                            -@discount% OFF
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                    {
                        <img src="@Model.Product.ImageUrl" alt="@Model.Product.Title">
                    }
                    else
                    {
                        <img src="https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=1200&h=800&fit=crop"
                             alt="@Model.Product.Title">
                    }
                </div>
            </div>

            <!-- RIGHT COLUMN: Product Information -->
            <div class="right-column">
                <!-- Category Badge -->
                @if (Model.Product.Categories != null)
                {
                    <div class="category-badge">
                        <i class="bi bi-bookmark-fill"></i>
                        @Model.Product.Categories.Name
                    </div>
                }

                <!-- Product Title -->
                <h1 class="product-title">@Model.Product.Title</h1>

                <!-- SKU/ISBN -->
                <p class="sku-text">
                    <i class="bi bi-upc"></i>
                    ISBN: @Model.Product.SKU
                </p>

                <!-- List Price -->
                <div class="list-price-section">
                    <div class="list-price-label">
                        <i class="bi bi-cash-coin"></i>
                        List Price
                    </div>
                    <div class="list-price-value">
                        $@Model.Product.Price.ToString("0.00")
                        @if (discount > 0)
                        {
                            <span class="old-price">$@Model.Product.ListPrice.ToString("0.00")</span>
                        }
                    </div>
                </div>

                <!-- Quantity Pricing Table -->
                <div class="quantity-pricing-section">
                    <div class="quantity-pricing-title">
                        <i class="bi bi-boxes"></i>
                        Quantity Pricing
                    </div>
                    <div class="pricing-table">
                        <div class="price-tier">
                            <div class="tier-quantity">1-50</div>
                            <div class="tier-price">$@Model.Product.Price.ToString("0.00")</div>
                        </div>
                        <div class="price-tier">
                            <div class="tier-quantity">51-100</div>
                            <div class="tier-price">$@Model.Product.Price50.ToString("0.00")</div>
                        </div>
                        <div class="price-tier">
                            <div class="tier-quantity">100+</div>
                            <div class="tier-price">$@Model.Product.Price100.ToString("0.00")</div>
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <div class="description-section">
                    <div class="description-title">
                        <i class="bi bi-info-circle"></i>
                        Description
                    </div>
                    <p>@Model.Product.Description</p>
                </div>

                <!-- Quantity Counter & Add to Cart -->
                <form method="post" asp-action="Details">
                    <input type="hidden" asp-for="ProductId" />

                    <div class="cart-actions">
                        <!-- Quantity Counter -->
                        <div class="quantity-section">
                            <span class="quantity-label">Quantity</span>
                            <div class="quantity-controls">
                                <button type="button" class="quantity-btn" id="decrease-btn">
                                    <i class="bi bi-dash"></i>
                                </button>
                                <span class="quantity-display" id="quantity-display">@Model.Count</span>
                                <button type="button" class="quantity-btn" id="increase-btn">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </div>
                        </div>

                        <input type="hidden" asp-for="Count" id="count-input" />

                        <!-- Add to Cart Button -->
                        <button type="submit" class="add-to-cart-btn">
                            <i class="bi bi-cart-plus"></i>
                            <span>Add to Cart</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Quantity Counter Logic
    const decreaseBtn = document.getElementById('decrease-btn');
    const increaseBtn = document.getElementById('increase-btn');
    const quantityDisplay = document.getElementById('quantity-display');
    const countInput = document.getElementById('count-input');

    let count = parseInt(quantityDisplay.textContent);

    // Decrease quantity
    decreaseBtn.addEventListener('click', function() {
        if (count > 1) {
            count--;
            updateQuantity();
        }
    });

    // Increase quantity
    increaseBtn.addEventListener('click', function() {
        if (count < 200) {
            count++;
            updateQuantity();
        }
    });

    // Update display and hidden input
    function updateQuantity() {
        quantityDisplay.textContent = count;
        countInput.value = count;
    }
</script>