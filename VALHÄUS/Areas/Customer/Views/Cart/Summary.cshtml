@model ShoppingCartVM

<!-- Google Fonts for Premium Typography -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Montserrat:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">


<form method="post" class="luxury-wrapper">
	<br />
	<div class="container luxury-container">
		<div class="card border-0 luxury-card">

			<div class="card-header bg-transparent border-0 pt-5 pb-3">
				<div class="row px-4 align-items-center">
					<div class="col-12 text-center">
						<h5 class="luxury-title">
							Order Summary
						</h5>
						<div class="luxury-divider mx-auto"></div>
					</div>
				</div>
				<div class="text-start mt-3 px-4">
					<a asp-action="Index" class="btn luxury-link-back">
						<i class="bi bi-arrow-left"></i> &larr; Return to Cart
					</a>
				</div>
			</div>

			<div class="card-body">
				<div class="container p-4">
					<div class="row">
						<!-- Shipping Details Section -->
						<div class="col-12 col-lg-7 pb-5 px-lg-5 border-end-lg luxury-section-left">
							<h4 class="luxury-subtitle mb-4">Shipping Details</h4>
							
							<div class="row mb-3 luxury-form-group">
								<div class="col-12">
									<label class="luxury-label">Full Name</label>
									@* <input asp-for="OrderHeader.Name" class="form-control luxury-input" placeholder="e.g. John Doe" />
									<span asp-validation-for="OrderHeader.Name" class="text-danger small"></span> *@
								</div>
							</div>
							<div class="row mb-3 luxury-form-group">
								<div class="col-12 col-md-6">
									<label class="luxury-label">Phone Number</label>
									@* <input asp-for="OrderHeader.PhoneNumber" class="form-control luxury-input" placeholder="+1 (555) 000-0000"/>
									<span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger small"></span> *@
								</div>
								<div class="col-12 col-md-6">
									<label class="luxury-label">City</label>
									@* <input asp-for="OrderHeader.City" class="form-control luxury-input" placeholder="New York" />
									<span asp-validation-for="OrderHeader.City" class="text-danger small"></span> *@
								</div>
							</div>
							<div class="row mb-3 luxury-form-group">
								<div class="col-12">
									<label class="luxury-label">Street Address</label>
									@* <input asp-for="OrderHeader.StreetAddress" class="form-control luxury-input" placeholder="123 Luxury Ave" />
									<span asp-validation-for="OrderHeader.StreetAddress" class="text-danger small"></span> *@
								</div>
							</div>
							<div class="row mb-3 luxury-form-group">
								<div class="col-12 col-md-6">
									<label class="luxury-label">State / Province</label>
									@* <input asp-for="OrderHeader.State" class="form-control luxury-input" placeholder="NY" />
									<span asp-validation-for="OrderHeader.State" class="text-danger small"></span> *@
								</div>
								<div class="col-12 col-md-6">
									<label class="luxury-label">Postal Code</label>
									@* <input asp-for="OrderHeader.PostalCode" class="form-control luxury-input" placeholder="10001" />
									<span asp-validation-for="OrderHeader.PostalCode" class="text-danger small"></span> *@
								</div>
							</div>
						</div>

						<!-- Order Summary Section -->
						<div class="col-12 col-lg-5 px-lg-5 pt-4 pt-lg-0">
							<h4 class="luxury-subtitle mb-4">Your Collection</h4>
							
							<div class="luxury-cart-items mb-4">
								@* @foreach(var details in Model.ShoppingCartList){
								<div class="d-flex justify-content-between align-items-center mb-3 luxury-item-row">
									<div>
										<h6 class="my-0 luxury-item-title">@details.Product.Title</h6>
										<small class="luxury-item-meta">Qty: @details.Count</small>
									</div>
									<span class="luxury-item-price">@((details.Price*details.Count).ToString("c"))</span>
								</div>
								} *@
							</div>

							<div class="luxury-total-section mt-4 pt-3">
								<div class="d-flex justify-content-between align-items-center mb-4">
									<span class="luxury-total-label">Total</span>
									<span class="luxury-total-amount">$125.00 @* @Model.OrderHeader.OrderTotal.ToString("c") *@</span>
								</div>
								
								<p class="luxury-arrival-text mb-4">
									Estimated Arrival: <span class="text-dark fw-bold">@DateTime.Now.AddDays(7).ToShortDateString() - @DateTime.Now.AddDays(14).ToShortDateString()</span>
								</p>

								<button type="submit" value="Place Order" class="btn w-100 luxury-btn-place p-3">
									COMPLETE ORDER
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>

<style>
	:root {
		--bg-color: #f9f9f9;
		--card-bg: #ffffff;
		--text-dark: #121212;
		--text-muted: #666666;
		--accent-gold: #C5A059;
		--accent-gold-hover: #b08d4b;
		--border-light: #e0e0e0;
		--font-heading: 'Cinzel', serif;
		--font-subheading: 'Playfair Display', serif;
		--font-body: 'Montserrat', sans-serif;
	}

	body {
		background-color: var(--bg-color);
		font-family: var(--font-body);
		color: var(--text-dark);
	}

	.luxury-container {
		max-width: 1200px;
		margin-top: 50px;
		margin-bottom: 50px;
	}

	.luxury-card {
		background: var(--card-bg);
		box-shadow: 0 20px 50px rgba(0,0,0,0.05);
		border-radius: 0; /* Sharp corners for premium feel */
	}

	/* Typography */
	.luxury-title {
		font-family: var(--font-heading);
		font-size: 2.5rem;
		letter-spacing: 4px;
		color: var(--text-dark);
		text-transform: uppercase;
		margin-bottom: 15px;
	}

	.luxury-subtitle {
		font-family: var(--font-subheading);
		font-size: 1.5rem;
		font-style: italic;
		color: var(--text-dark);
		border-bottom: 1px solid var(--accent-gold);
		padding-bottom: 10px;
		display: inline-block;
	}

	.luxury-divider {
		height: 2px;
		width: 60px;
		background-color: var(--accent-gold);
		margin-bottom: 20px;
	}

	.luxury-label {
		font-weight: 500;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		color: var(--text-muted);
		margin-bottom: 8px;
	}

	/* Inputs */
	.luxury-input {
		border: 1px solid var(--border-light);
		border-radius: 0;
		padding: 12px 15px;
		font-family: var(--font-body);
		font-size: 0.95rem;
		background-color: #fafafa;
		transition: all 0.3s ease;
	}

	.luxury-input:focus {
		border-color: var(--accent-gold);
		box-shadow: none; /* No glow, just clean border */
		background-color: #fff;
	}

	/* Links & Buttons */
	.luxury-link-back {
		color: var(--text-muted);
		font-size: 0.9rem;
		letter-spacing: 1px;
		text-decoration: none;
		transition: color 0.3s ease;
	}

	.luxury-link-back:hover {
		color: var(--text-dark);
	}

	.luxury-btn-place {
		background-color: var(--text-dark);
		color: #fff;
		font-family: var(--font-heading);
		font-size: 1.1rem;
		letter-spacing: 2px;
		border-radius: 0;
		transition: all 0.4s ease;
		border: 1px solid var(--text-dark);
	}

	.luxury-btn-place:hover {
		background-color: transparent;
		color: var(--text-dark);
	}

	/* Order Summary Items */
	.luxury-item-title {
		font-family: var(--font-subheading);
		font-size: 1.1rem;
		font-weight: 600;
	}

	.luxury-item-meta {
		color: var(--text-muted);
		font-size: 0.85rem;
	}

	.luxury-item-price {
		font-family: var(--font-body);
		font-weight: 500;
		color: var(--text-dark);
	}

	.luxury-total-section {
		border-top: 1px solid var(--border-light);
	}

	.luxury-total-label {
		font-family: var(--font-heading);
		font-size: 1.2rem;
	}

	.luxury-total-amount {
		font-family: var(--font-subheading);
		font-size: 1.8rem;
		font-weight: 700;
		color: var(--accent-gold);
	}

	.luxury-arrival-text {
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	/* Responsive Spacing */
	.border-end-lg {
		border-right: 1px solid var(--border-light);
	}

	@@media (max-width: 991px) {
		.border-end-lg {
			border-right: none;
			border-bottom: 1px solid var(--border-light);
			padding-bottom: 40px;
			margin-bottom: 40px;
		}
	}
</style>