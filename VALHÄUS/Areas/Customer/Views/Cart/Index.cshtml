@model ShoppingCartVM

<div class="cart-container">
    <form method="post">
        <!-- Header -->
        <div class="cart-header">
            <h1 class="cart-title">Shopping Cart</h1>
            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="continue-shopping">
                <span>←</span> Continue Shopping
            </a>
        </div>

        <div class="cart-layout">
            <!-- Left Column: Cart Items -->
            <div class="cart-items-section">
                @if (Model.ShoppingCartList.Count() > 0)
                {
                    @foreach (var item in Model.ShoppingCartList)
                    {
                        <div class="cart-item-card">
                            <!-- Product Image -->
                            <div class="item-image-wrapper">
                                @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                {
                                    <img src="@item.Product.ImageUrl" alt="@item.Product.Title" />
                                }
                                else
                                {
                                    <img src="https://placehold.co/500x600/png" alt="No image" />
                                }
                            </div>

                            <!-- Item Details -->
                            <div class="item-details">
                                <h3 class="item-title">@item.Product.Title</h3>
                                <div class="item-description">
                                    @Html.Raw(item.Product.Description)
                                </div>
                                <div class="item-meta">
                                    <span class="item-price">@item.Price.ToString("c")</span>
                                </div>
                            </div>

                            <!-- Actions (Quantity & Remove) -->
                            <div class="item-actions">
                                <!-- Quantity Controls -->
                                <div class="quantity-control-group">
                                    <a asp-action="minus" asp-route-cartId="@item.Id" class="qty-btn" aria-label="Decrease quantity">
                                        <i class="bi bi-dash"></i>
                                    </a>
                                    <span class="qty-value">@item.Count</span>
                                    <a asp-action="plus" asp-route-cartId="@item.Id" class="qty-btn" aria-label="Increase quantity">
                                        <i class="bi bi-plus"></i>
                                    </a>
                                </div>

                                @* <!-- Subtotal for Item -->
                                <div class="item-total-display">
                                    @((item.Price * item.Count).ToString("c"))
                                </div> *@

                                <!-- Remove Button -->
                                <a asp-action="remove" asp-route-cartId="@item.Id" class="remove-btn" title="Remove item">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-cart-state">
                        <div class="empty-icon">🛒</div>
                        <h3>Your cart is empty</h3>
                        <p>Looks like you haven't added anything to your cart yet.</p>
                        <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn-shop-now">
                            Start Shopping
                        </a>
                    </div>
                }
            </div>

            <!-- Right Column: Order Summary (Sticky) -->
            @if (Model.ShoppingCartList.Count() > 0)
            {
                <div class="cart-summary-section">
                    <div class="summary-card">
                        <h3 class="summary-title">Order Summary</h3>
                        
                        @* <div class="summary-row">
                            <span>Subtotal</span>
                            <span>@Model.OrderTotal.ToString("c")</span>
                        </div> *@
                        
                        <!-- You can add Tax/Shipping here if needed later -->
                         @* <div class="summary-row">
                            <span>Estim. Tax</span>
                            <span>$0.00</span>
                        </div> *@

                        <div class="summary-divider"></div>

                        <div class="summary-row total">
                            <span>Total</span>
                            <span class="total-price">@Model.OrderHeader.OrderTotal.ToString("c")</span>
                        </div>

                        <a asp-action="Summary" class="btn-checkout">
                            Summary
                        </a>

                        <div class="secure-checkout-badge">
                            <i class="bi bi-shield-lock"></i> Secure Checkout
                        </div>
                    </div>
                </div>
            }
        </div>
    </form>
</div>

<style>
    /* ===== Page Layout ===== */
    .cart-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem 1rem;
        min-height: 80vh;
    }

    .cart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #eee;
    }

    .cart-title {
        font-size: 2rem;
        font-weight: 700;
        margin: 0;
        color: #1a1a1a;
    }

    .continue-shopping {
        color: #555;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }

    .continue-shopping:hover {
        color: #000;
        transform: translateX(-5px);
    }

    .cart-layout {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 3rem;
        align-items: start;
    }

    /* ===== Cart Items ===== */
    .cart-items-section {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .cart-item-card {
        display: grid;
        grid-template-columns: 120px 2fr 1.5fr;
        gap: 1.5rem;
        background: #fff;
        padding: 1.5rem;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        border: 1px solid #f0f0f0;
        align-items: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .cart-item-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    }

    .item-image-wrapper {
        width: 120px;
        height: 120px;
        border-radius: 8px;
        overflow: hidden;
        background: #f8f8f8;
    }

    .item-image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .item-details {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .item-title {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0;
        color: #333;
    }

    .item-description {
        font-size: 0.85rem;
        color: #666;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .item-price {
        font-weight: 600;
        color: #333;
        font-size: 1rem;
    }

    .item-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    /* Quantity Controls */
    .quantity-control-group {
        display: flex;
        align-items: center;
        background: #f8f9fa;
        border-radius: 50px;
        padding: 4px;
        border: 1px solid #e0e0e0;
    }

    .qty-btn {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #fff;
        color: #333;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .qty-btn:hover {
        background: #333;
        color: #fff;
    }

    .qty-value {
        width: 40px;
        text-align: center;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .item-total-display {
        font-weight: 700;
        color: #1a1a1a;
        font-size: 1.1rem;
    }

    .remove-btn {
        color: #999;
        font-size: 1.2rem;
        transition: color 0.3s ease;
        padding: 0.5rem;
    }

    .remove-btn:hover {
        color: #dc3545;
    }

    /* ===== Summary Section ===== */
    .cart-summary-section {
        position: sticky;
        top: 2rem;
    }

    .summary-card {
        background: #fff;
        padding: 2rem;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.08);
        border: 1px solid #f0f0f0;
    }

    .summary-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        color: #1a1a1a;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 1rem;
        color: #555;
        font-size: 0.95rem;
    }

    .summary-divider {
        height: 1px;
        background: #eee;
        margin: 1.5rem 0;
    }

    .summary-row.total {
        font-size: 1.25rem;
        font-weight: 800;
        color: #000;
        margin-bottom: 2rem;
    }

    .btn-checkout {
        display: block;
        width: 100%;
        text-align: center;
        background: linear-gradient(135deg, #1a1a1a 0%, #333 100%);
        color: #fff;
        padding: 1rem;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .btn-checkout:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        color: #fff;
    }

    .secure-checkout-badge {
        text-align: center;
        margin-top: 1rem;
        font-size: 0.8rem;
        color: #888;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    /* ===== Empty State ===== */
    .empty-cart-state {
        text-align: center;
        padding: 4rem 2rem;
        background: #fff;
        border-radius: 16px;
        border: 1px solid #eee;
    }

    .empty-icon {
        font-size: 4rem;
        margin-bottom: 1.5rem;
        opacity: 0.5;
    }

    .btn-shop-now {
        display: inline-block;
        margin-top: 1.5rem;
        padding: 0.8rem 2rem;
        background: #333;
        color: #fff;
        text-decoration: none;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    
    .btn-shop-now:hover {
        background: #000;
        color: #fff;
    }

    /* ===== Dark Mode Support ===== */
    html[data-bs-theme="dark"] .cart-title,
    html[data-bs-theme="dark"] .item-title,
    html[data-bs-theme="dark"] .item-price,
    html[data-bs-theme="dark"] .item-total-display,
    html[data-bs-theme="dark"] .summary-title,
    html[data-bs-theme="dark"] .summary-row.total,
    html[data-bs-theme="dark"] .continue-shopping:hover {
        color: #f0f0f0;
    }

    html[data-bs-theme="dark"] .cart-item-card,
    html[data-bs-theme="dark"] .summary-card,
    html[data-bs-theme="dark"] .empty-cart-state {
        background: #1e1e1e;
        border-color: #333;
    }

    html[data-bs-theme="dark"] .cart-header {
        border-bottom-color: #333;
    }

    html[data-bs-theme="dark"] .continue-shopping {
        color: #bbb;
    }

    html[data-bs-theme="dark"] .item-description,
    html[data-bs-theme="dark"] .summary-row {
        color: #aaa;
    }

    html[data-bs-theme="dark"] .item-image-wrapper {
        background: #2a2a2a;
    }

    html[data-bs-theme="dark"] .quantity-control-group {
        background: #2a2a2a;
        border-color: #444;
    }

    html[data-bs-theme="dark"] .qty-btn {
        background: #333;
        color: #ccc;
    }

    html[data-bs-theme="dark"] .qty-btn:hover {
        background: #fff;
        color: #000;
    }

    html[data-bs-theme="dark"] .btn-checkout {
        background: linear-gradient(135deg, #e8a87c 0%, #d6976b 100%);
        color: #1a1a1a;
    }

    /* ===== Responsive ===== */
    @@media (max-width: 992px) {
        .cart-layout {
            grid-template-columns: 1fr;
        }

        .summary-card {
            margin-top: 2rem;
        }

        .cart-container {
            padding: 1rem;
        }
    }

    @@media (max-width: 576px) {
        .cart-item-card {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .item-image-wrapper {
            margin: 0 auto;
        }

        .item-actions {
            flex-direction: column;
            width: 100%;
            gap: 1.5rem;
        }

        .item-details {
            align-items: center;
        }
    }
</style>
