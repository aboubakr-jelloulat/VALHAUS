@model ShoppingCartVM


<form method="post">
	<br />
	<div class="container">
		<div class="card shadow border-0 luxury-card">

			<div class="card-header bg-secondary bg-gradient text-light ml-0 py-4 luxury-header">
				<div class="row px-4">
					<div class="col-6">
						<h5 class="pt-2 text-white text-uppercase luxury-title">
							Order Summary
						</h5>
					</div>
					<div class="col-6 text-end">
						<a asp-action="Index" class="btn btn-outline-danger btn-sm luxury-btn-back">Back to Cart</a>
					</div>
				</div>
			</div>
			<div class="card-body luxury-body">
				<div class="container rounded p-2">
					<div class="row">
						<div class="col-12 col-lg-6 pb-4">
							<div class="row">
								<h4 class="d-flex justify-content-between align-items-center mb-3">
									<span class="text-gold">Shipping Details:</span>
								</h4>
							</div>
							<div class="row my-1">
								<div class="col-3">
									<label class="text-muted-gold">Name</label>
								</div>
								<div class="col-9">
									@* <input asp-for="OrderHeader.Name" class="form-control luxury-input" />
									<span asp-validation-for="OrderHeader.Name" class="text-danger"></span> *@
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">
									<label class="text-muted-gold">Phone</label>
								</div>
								<div class="col-9">
									@* <input asp-for="OrderHeader.PhoneNumber" class="form-control luxury-input" />
									<span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger"></span> *@
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">
									<label class="text-muted-gold">Street Address</label>
								</div>
								<div class="col-9">
									@* <input asp-for="OrderHeader.StreetAddress" class="form-control luxury-input" />
									<span asp-validation-for="OrderHeader.StreetAddress" class="text-danger"></span> *@
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">
									<label class="text-muted-gold">City</label>
								</div>
								<div class="col-9">
									@* <input asp-for="OrderHeader.City" class="form-control luxury-input" />
									<span asp-validation-for="OrderHeader.City" class="text-danger"></span> *@
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">
									<label class="text-muted-gold">State</label>
								</div>
								<div class="col-9">
									@* <input asp-for="OrderHeader.State" class="form-control luxury-input" />
									<span asp-validation-for="OrderHeader.State" class="text-danger"></span> *@
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">
									<label class="text-muted-gold">Postal Code</label>
								</div>
								<div class="col-9">
									@* <input asp-for="OrderHeader.PostalCode" class="form-control luxury-input" />
									<span asp-validation-for="OrderHeader.PostalCode" class="text-danger"></span> *@
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-5 offset-lg-1">
							<h4 class="d-flex justify-content-between align-items-center mb-3">
								<span class="text-gold">Order Summary:</span>
							</h4>
							<ul class="list-group mb-3 luxury-list">
								@* @foreach(var details in Model.ShoppingCartList){
								<li class="list-group-item d-flex justify-content-between luxury-list-item">
									<div>
											<h6 class="my-0 text-white">@details.Product.Title</h6>
											<small class="text-muted-gold">Quantity: @details.Count</small>
									</div>
									<span class="text-gold">@((details.Price*details.Count).ToString("c")) </span>
								</li>
								} *@

								<li class="list-group-item d-flex justify-content-between bg-dark luxury-list-total">
									<small class="text-gold">Total (USD)</small>
									<strong class="text-gold">$125.00 @* @Model.OrderHeader.OrderTotal.ToString("c") *@</strong>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
			<div class="card-footer luxury-footer">
				<div class="row">
					<div class="col-12 col-md-8 pt-2">
						<p class="luxury-arrival-text">
							Estimate Arrival Date:
							<span class="text-gold">@DateTime.Now.AddDays(7).ToShortDateString() - @DateTime.Now.AddDays(14).ToShortDateString()</span>
						</p>
					</div>
					<div class="col-12 col-md-4">
						<button type="submit" value="Place Order" class="btn btn-primary form-control luxury-btn-place">Place Order</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>

<style>
	/* Luxury UI Variables */
	:root {
		--gold-primary: #d4af37;
		--gold-dim: #c5a059;
		--gold-light: #f7e7ce;
		--black-rich: #1a1a1a;
		--black-card: #222222;
		--black-dark: #121212;
		--border-gold: 1px solid #d4af37;
		--font-luxury: 'Playfair Display', serif; /* Optional, falls back gracefully */
	}

	/* Card Styling */
	.luxury-card {
		background-color: var(--black-card);
		border: var(--border-gold);
		border-radius: 8px;
		color: #ffffff;
		box-shadow: 0 4px 15px rgba(0,0,0,0.5);
	}

	.luxury-header {
		background: linear-gradient(45deg, #1a1a1a, #2c2c2c);
		border-bottom: 2px solid var(--gold-primary);
	}

	.luxury-title {
		font-family: var(--font-luxury);
		font-weight: bold;
		letter-spacing: 1px;
		color: var(--gold-light) !important;
	}

	.luxury-body {
		background-color: var(--black-rich);
		color: #e0e0e0;
	}

	.luxury-footer {
		background-color: var(--black-card);
		border-top: 1px solid var(--gold-dim);
	}

	/* Text Styling */
	.text-gold {
		color: var(--gold-primary) !important;
	}

	.text-muted-gold {
		color: #a8a8a8;
	}

	/* Input Styling */
	.luxury-input {
		background-color: #333;
		border: 1px solid #555;
		color: white;
	}
	.luxury-input:focus {
		background-color: #444;
		border-color: var(--gold-primary);
		box-shadow: 0 0 5px rgba(212, 175, 55, 0.5);
		color: white;
	}

	/* Button Styling */
	.luxury-btn-back {
		color: var(--gold-dim);
		border-color: var(--gold-dim);
	}
	.luxury-btn-back:hover {
		background-color: var(--gold-dim);
		color: #000;
	}

	.luxury-btn-place {
		background: linear-gradient(to right, #d4af37, #c5a059);
		border: none;
		color: #000;
		font-weight: bold;
		text-transform: uppercase;
		transition: transform 0.2s;
	}
	.luxury-btn-place:hover {
		transform: scale(1.02);
		background: linear-gradient(to right, #edc967, #d4af37);
		box-shadow: 0 0 10px rgba(212, 175, 55, 0.4);
		color: #000;
	}

	/* List Group Styling */
	.luxury-list-item {
		background-color: #2a2a2a;
		border-color: #444;
		color: white;
	}
	
	.luxury-list-total {
		background-color: #111 !important;
		border: 1px solid var(--gold-primary);
		border-radius: 4px;
	}

	.luxury-arrival-text {
		color: #ccc;
		font-size: 14px;
	}
</style>