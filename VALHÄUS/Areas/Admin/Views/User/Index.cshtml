@section Styles {
    <link rel="stylesheet" href="~/css/User/user.css?v=1.0.2" />
}

<div class="header text-center">
    <h1>USER MANAGEMENT</h1>
    <div class="accent-line">
        <span></span>
    </div>
    <p class="subtitle">SYSTEM USERS & PERMISSIONS</p>
</div>

<div class="user-table-container">
    <table id="tblData" class="user-table" style="width:100%">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Company</th>
                <th>Role</th>
                <th class="actions-col">Actions</th>
            </tr>
        </thead>
    </table>
</div>

<div class="text-center text-muted py-4">
    <small>Total Users: <span id="userCount">0</span></small>
</div>

@section Scripts {
    <script src="~/js/User/user.js?v=2.0.0"></script>
}