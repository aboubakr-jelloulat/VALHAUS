@model int


<style>
    :root {
        --success-color: #10b981;
        --success-light: #d1fae5;
        --primary-color: #6366f1;
        --text-primary: #1f2937;
        --text-secondary: #6b7280;
        --card-bg: #ffffff;
        --border-color: #e5e7eb;
    }

    [data-bs-theme="dark"] {
        --success-color: #34d399;
        --success-light: #065f46;
        --primary-color: #818cf8;
        --text-primary: #f9fafb;
        --text-secondary: #9ca3af;
        --card-bg: #1f2937;
        --border-color: #374151;
    }

    .success-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 0;
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(99, 102, 241, 0.05) 100%);
    }

    .success-card {
        background: var(--card-bg);
        border-radius: 1.5rem;
        padding: 3rem 2rem;
        text-align: center;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        border: 3px solid var(--success-color);
        position: relative;
        overflow: hidden;
    }

    .success-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient(90deg, var(--success-color) 0%, var(--primary-color) 100%);
    }

    .success-title {
        color: var(--success-color);
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        animation: fadeInDown 0.6s ease;
    }

    .order-number-container {
        background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);
        color: white;
        padding: 1.5rem 2rem;
        border-radius: 1rem;
        margin: 2rem auto;
        max-width: 500px;
        box-shadow: 0 10px 20px rgba(16, 185, 129, 0.3);
        animation: scaleIn 0.5s ease 0.3s both;
    }

    .order-label {
        font-size: 1rem;
        opacity: 0.9;
        margin-bottom: 0.5rem;
        font-weight: 500;
    }

    .order-number {
        font-size: 2.5rem;
        font-weight: 700;
        letter-spacing: 2px;
        margin: 0;
    }

    .success-message {
        color: var(--text-secondary);
        font-size: 1.125rem;
        margin: 2rem 0;
        animation: fadeIn 0.6s ease 0.5s both;
    }

    .checkmark-container {
        margin: 2rem auto;
        animation: scaleIn 0.5s ease both;
    }

    /* Animated Checkmark */
    .checkmark-circle {
        width: 150px;
        height: 150px;
        position: relative;
        display: inline-block;
        vertical-align: top;
        margin: 0 auto;
    }

    .checkmark-circle .background {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);
        position: absolute;
        animation: scaleIn 0.5s ease both;
    }

    .checkmark-circle .checkmark {
        border-radius: 5px;
    }

    .checkmark-circle .checkmark.draw:after {
        animation-delay: 0.3s;
        animation-duration: 0.5s;
        animation-timing-function: ease;
        animation-name: checkmark;
        transform: scaleX(-1) rotate(135deg);
        animation-fill-mode: forwards;
    }

    .checkmark-circle .checkmark:after {
        opacity: 1;
        height: 75px;
        width: 37.5px;
        transform-origin: left top;
        border-right: 6px solid white;
        border-top: 6px solid white;
        border-radius: 2.5px;
        content: '';
        left: 35px;
        top: 75px;
        position: absolute;
    }

    @@keyframes checkmark {
        0% {
            height: 0;
            width: 0;
            opacity: 1;
        }
        20% {
            height: 0;
            width: 37.5px;
            opacity: 1;
        }
        40% {
            height: 75px;
            width: 37.5px;
            opacity: 1;
        }
        100% {
            height: 75px;
            width: 37.5px;
            opacity: 1;
        }
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @@keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .confetti {
        position: absolute;
        width: 10px;
        height: 10px;
        background: var(--success-color);
        animation: confetti-fall 3s linear infinite;
    }

    @@keyframes confetti-fall {
        to {
            transform: translateY(100vh) rotate(360deg);
            opacity: 0;
        }
    }

    .action-buttons {
        margin-top: 2rem;
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
        animation: fadeIn 0.6s ease 0.7s both;
    }

    .btn-custom {
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        border: 2px solid;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--primary-color) 0%, #8b5cf6 100%);
        color: white;
        border-color: var(--primary-color);
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3);
        color: white;
    }

    .btn-outline-custom {
        background: transparent;
        color: var(--text-primary);
        border-color: var(--border-color);
    }

    .btn-outline-custom:hover {
        background: var(--card-bg);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        color: var(--text-primary);
    }

    @@media (max-width: 768px) {
        .success-title {
            font-size: 1.75rem;
        }

        .order-number {
            font-size: 1.75rem;
        }

        .success-card {
            padding: 2rem 1.5rem;
        }

        .checkmark-circle,
        .checkmark-circle .background {
            width: 120px;
            height: 120px;
        }

        .checkmark-circle .checkmark:after {
            height: 60px;
            width: 30px;
            left: 28px;
            top: 60px;
        }
    }
</style>

<div class="success-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="success-card">
                    <!-- Animated Checkmark -->
                    <div class="checkmark-container">
                        <div class="checkmark-circle">
                            <div class="background"></div>
                            <div class="checkmark draw"></div>
                        </div>
                    </div>

                    <!-- Success Title -->
                    <h1 class="success-title">
                        🎉 Order Confirmed!
                    </h1>

                    <!-- Order Number -->
                    <div class="order-number-container">
                        <p class="order-label">Your Order Number</p>
                        <h2 class="order-number">#@Model</h2>
                    </div>

                    <!-- Success Message -->
                    <div class="success-message">
                        <p>
                            <strong>Thank you for your order!</strong><br/>
                            Your order has been successfully placed and is being processed.<br/>
                            You will receive a confirmation email shortly.
                        </p>
                    </div>

                    <!-- Action Buttons -->
                    <div class="action-buttons">
                        <a href="@Url.Action("Index", "Home")" class="btn-custom btn-primary-custom">
                            Continue Shopping
                        </a>
                        @* <a href="@Url.Action("OrderHistory", "Order")" class="btn-custom btn-outline-custom">
                            View Orders
                        </a> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>