@model int

<a asp-area="Customer" asp-controller="Cart" asp-action="Index" class="nav-link position-relative text-dark">
    <i class="bi bi-cart3" style="font-size: 1.8rem;"></i>
    @if (Model > 0)
    {
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
              style="font-size: 0.75rem; padding: 0.35em 0.5em;">
            @Model
        </span>
    }
</a>
